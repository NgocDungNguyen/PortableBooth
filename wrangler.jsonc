// Cloudflare Workers: `npm run build` makes dist/, `npx wrangler deploy` publishes it.
// Static files are served straight from dist/ (dist/_headers, copied from public/_headers, sets the security headers).
// worker/index.js only handles /beam/*: the end-to-end encrypted relay behind "Send to a phone".
{
  "name": "portablebooth",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "BEAM", "class_name": "BeamRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BeamRoom"] }],
  "observability": { "enabled": false }
}
